# Copy to .env and fill in what you need. Every variable is optional in development;
# the app turns off the features whose settings are missing. See src/config.js.

# --- Server ---------------------------------------------------------------------------
# PORT=3000
# Public URL of the app, used for invite links, email links, the QR code and the Google
# OAuth redirect. Defaults to http://localhost:$PORT.
# BASE_URL=http://localhost:3000
# Set to "production" when deployed: turns on template caching and requires SESSION_SECRET.
# NODE_ENV=production

# Signs session cookies and encrypts Google tokens at rest. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out and makes stored Google tokens unreadable.
SESSION_SECRET=

# "Dev login" form on the login page (sign in as any name, no password). On by default under `pnpm dev`,
# always off in production. Set to 0 to hide it, 1 to show it under `pnpm start`.
# DEV_LOGIN=0

# --- Database -------------------------------------------------------------------------
# Leave unset to use a local SQLite file at data/local.db.
# A libsql:// URL points at Turso. Migrations run against it at startup, so be careful
# pointing a dev server at the production database.
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# --- Google sign-in and Google Tasks sync (optional) ----------------------------------
# OAuth client (type "Web application") from Google Cloud Console, with the Google Tasks
# API enabled. Authorized redirect URI: $BASE_URL/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# How often to poll each member's Google Tasks list for changes (seconds).
# GOOGLE_SYNC_INTERVAL_SECONDS=120
# Name of the list created in each member's Google Tasks.
# GOOGLE_TASK_LIST_TITLE=Task Sloth

# --- Task photos (optional) -----------------------------------------------------------
# Cloudinary dashboard → Settings → API Keys → "API environment variable".
# Without it, the photo buttons are hidden.
# CLOUDINARY_URL=cloudinary://<api key>:<api secret>@<cloud name>

# --- Email (optional in development, required in production) -------------------------
# Used for sign-up and email-change confirmation links. Any SMTP server works; use
# smtps:// for implicit TLS on port 465, smtp:// for STARTTLS (default port 587).
# Without it, development prints each message to the console instead of sending it,
# and production fails to send.
# SMTP_URL=smtps://<user>:<password>@<host>:465
# MAIL_FROM="Task Sloth <noreply@example.com>"
