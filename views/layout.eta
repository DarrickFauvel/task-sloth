<!doctype html>
<%/* it.theme is "light", "dark", or unset (follow the device); see the theme cookie in server.js.
     it.you is the signed-in member's color: the accent follows it (see --you in app.css).
     it.icons is "off" when someone turned icons off in Settings (the icons cookie): .emoji hides.
     it.sloth is "quiet" when someone tapped Task Sloth's head to tuck its words away (the sloth cookie). */%>
<% const you = /^#[0-9a-f]{6}$/i.test(it.you ?? "") ? it.you : null; %>
<html lang="en"<%~ it.theme ? ` data-theme="${it.theme}"` : "" %><%~ it.icons === "off" ? ' data-icons="off"' : "" %><%~ it.sloth === "quiet" ? ' data-sloth="quiet"' : "" %><%~ you ? ` style="--you: ${you}"` : "" %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% if (it.theme) { %>
    <meta name="theme-color" content="<%= it.theme === 'dark' ? '#131913' : '#f5f2e8' %>">
  <% } else { %>
    <meta name="theme-color" content="#f5f2e8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#131913" media="(prefers-color-scheme: dark)">
  <% } %>
  <title><%= it.title ? `${it.title} · Task Sloth` : "Task Sloth" %></title>
  <% if (it.description) { %>
    <meta name="description" content="<%= it.description %>">
    <meta property="og:title" content="Task Sloth">
    <meta property="og:description" content="<%= it.description %>">
    <meta property="og:image" content="<%= it.baseUrl ?? "" %>/img/logo.png">
  <% } %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%/* Installable as an app; public/sw.js shows an offline page and caches styles, scripts and images. */%>
  <link rel="manifest" href="/manifest.webmanifest">
  <%/* The rounded Nunito face app.css uses; preloaded so text doesn't swap fonts after it shows. */%>
  <link rel="preload" href="/fonts/nunito-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset("/css/app.css") %>">
  <%/* Gives a module's own imports (./lib/dates.js) the same versioned URLs as asset(); see src/lib/assets.js.
       It has to come before any module script. */%>
  <% if (it.importMap) { %><script type="importmap"><%~ it.importMap %></script><% } %>
  <script>
    document.cookie = `tz=${encodeURIComponent(Intl.DateTimeFormat().resolvedOptions().timeZone)}; path=/; max-age=31536000; samesite=lax`;
    // Toasts (views/partials/flash.eta): slide out, then leave the page.
    function dismissToast(toast) {
      if (!toast || toast.classList.contains("is-leaving")) return;
      toast.classList.add("is-leaving");
      setTimeout(() => toast.remove(), 300);
    }
    // leaveThen(row, then): a soft exit for a row that's about to go (e.g. Hide on a finished task). It fades,
    // slides a little aside and closes up its space, so the rows below glide up, and then calls `then` (which
    // asks the server; its re-render drops the row for good). If the row is somehow still there a few
    // seconds later (the request failed), it comes back.
    function leaveThen(row, then) {
      if (!row || matchMedia("(prefers-reduced-motion: reduce)").matches) return then();
      row.style.height = `${row.offsetHeight}px`;
      row.getBoundingClientRect(); // start the height transition from here
      row.classList.add("is-leaving");
      setTimeout(then, 320);
      setTimeout(() => row.isConnected && (row.classList.remove("is-leaving"), row.style.height = ""), 5000);
    }
    // highlightTasks(ids): after finishing a task frees others up, scroll to the first freed row on this list
    // and give each a brief glow. It's an animation, not a class, so the live re-render that follows (which
    // resets each row's attributes) leaves it running. Rows not on this list are skipped.
    function highlightTasks(ids) {
      const rows = ids.map((id) => document.getElementById(`task-${id}`)).filter(Boolean);
      if (!rows.length) return;
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      rows[0].scrollIntoView({ block: "center", behavior: still ? "auto" : "smooth" });
      const probe = document.body.appendChild(Object.assign(document.createElement("i"), { style: "background: var(--tint-strong)" }));
      const glow = getComputedStyle(probe).backgroundColor;
      probe.remove();
      const frames = [{ backgroundColor: glow }, { backgroundColor: glow, offset: still ? 0.99 : 0.6 }, { backgroundColor: "transparent" }];
      for (const row of rows) row.animate(frames, { duration: 2600, easing: "ease-out" });
    }
    // Light/dark. setTheme("light" | "dark" | null) saves the choice (null = match the device) and, where the
    // browser supports view transitions and motion is welcome, grows the new theme out of `origin` in a soft
    // circle (see ::view-transition-new in app.css). Used by the menu's toggle and Settings > Appearance.
    const darkQuery = matchMedia("(prefers-color-scheme: dark)");
    const shownTheme = (choice) => choice ?? (darkQuery.matches ? "dark" : "light");
    // Icons on or off (Settings > Appearance): saves the choice and hides or shows the decorative emoji at once.
    function setIcons(on) {
      if (on) delete document.documentElement.dataset.icons;
      else document.documentElement.dataset.icons = "off";
      document.cookie = on ? "icons=; path=/; max-age=0; samesite=lax" : "icons=off; path=/; max-age=31536000; samesite=lax";
      document.querySelectorAll("[data-icons-choice]").forEach((b) => b.classList.toggle("is-on", b.dataset.iconsChoice === (on ? "on" : "off")));
    }
    // Tapping Task Sloth's head (partials/sloth-head) tucks its encouraging words away, or brings them back,
    // everywhere at once; the choice is kept on this device.
    function toggleSloth() {
      const root = document.documentElement;
      const quiet = root.dataset.sloth !== "quiet";
      if (quiet) root.dataset.sloth = "quiet";
      else delete root.dataset.sloth;
      document.cookie = quiet ? "sloth=quiet; path=/; max-age=31536000; samesite=lax" : "sloth=; path=/; max-age=0; samesite=lax";
    }
    function setTheme(choice, origin) {
      const root = document.documentElement;
      const next = shownTheme(choice);
      const apply = () => {
        if (choice) root.dataset.theme = choice;
        else delete root.dataset.theme;
        document.cookie = choice ? `theme=${choice}; path=/; max-age=31536000; samesite=lax` : "theme=; path=/; max-age=0; samesite=lax";
        document.querySelectorAll("meta[name=theme-color]").forEach((m) => {
          m.removeAttribute("media");
          m.content = next === "dark" ? "#131913" : "#f5f2e8";
        });
        document.querySelectorAll("[data-theme-choice]").forEach((b) => b.classList.toggle("is-on", b.dataset.themeChoice === (choice ?? "system")));
      };
      if (next === shownTheme(root.dataset.theme) || !document.startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) return apply();
      const box = origin?.getBoundingClientRect();
      const x = box ? box.left + box.width / 2 : innerWidth / 2;
      const y = box ? box.top + box.height / 2 : 0;
      // Far enough to cover the farthest corner, plus the feathered edge (12rem, see app.css).
      const feather = 12 * parseFloat(getComputedStyle(root).fontSize);
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + feather;
      root.style.setProperty("--theme-x", `${x}px`);
      root.style.setProperty("--theme-y", `${y}px`);
      // is-theming scopes the circle (see app.css) to this transition, not to page-to-page ones.
      root.classList.add("is-theming");
      const transition = document.startViewTransition(apply);
      transition.finished.finally(() => root.classList.remove("is-theming"));
      transition.ready.then(() => {
        root.animate(
          { "--theme-r": ["0px", `${radius}px`] },
          // fill: "forwards" holds the full circle until the browser removes the transition; without it
          // the radius snaps back to 0 for a frame or two first, and the old theme flashes through.
          { duration: 700, easing: "cubic-bezier(0.45, 0, 0.25, 1)", fill: "forwards", pseudoElement: "::view-transition-new(root)" },
        );
      });
    }
    // Runs fn now, or, on a page the browser is prerendering (see the speculation rules below), once it's
    // actually shown, so a page someone might open doesn't start its live stream early.
    function whenShown(fn) {
      if (document.prerendering) document.addEventListener("prerenderingchange", () => fn(), { once: true });
      else fn();
    }
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("/sw.js<%= it.dev ? '?dev=1' : '' %>").catch((err) => console.warn("service worker not registered", err));
    }
    // The menu's light/dark item: switch to whichever isn't showing.
    function toggleTheme(origin) {
      setTheme(shownTheme(document.documentElement.dataset.theme) === "dark" ? "light" : "dark", origin);
    }
  </script>
  <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
  <%/* Prerender the app's own pages when someone looks set to open one (hovering a link for a moment, or
       pressing it), so it shows at once. Only pages that are safe to load without being asked: not sign-out,
       sign-in callbacks, email or invite links, or anything that isn't a page. */%>
  <script type="speculationrules">
    { "prerender": [{
      "where": { "and": [
        { "or": [
          { "href_matches": { "pathname": "/" } }, { "href_matches": { "pathname": "/tasks/:id" } }, { "href_matches": { "pathname": "/tasks/:id/edit" } },
          { "href_matches": { "pathname": "/activity" } }, { "href_matches": { "pathname": "/help" } }, { "href_matches": { "pathname": "/about" } },
          { "href_matches": { "pathname": "/settings" } }, { "href_matches": { "pathname": "/sort" } }
        ] },
        { "not": { "selector_matches": "[data-no-prerender]" } }
      ] },
      "eagerness": "moderate"
    }] }
  </script>
</head>
<body>
  <main<%~ it.wide ? ' class="is-wide"' : "" %>>
    <%/* Pages other than home ask for the app's header and account menu with appNav: "slim", plus the phone's bottom
         bar and its More sheet with appNav: "full" (it.chrome is set per request in server.js). Home draws its own. */%>
    <% const c = it.appNav && it.chrome; %>
    <% if (c) { %>
      <%~ include("/partials/app-header", { user: c.user, membership: c.membership, coach: c.coach, slim: true }) %>
      <%~ include("/partials/qr-dialog", c.qr) %>
    <% } %>
    <%~ it.body %>
    <% if (c && it.appNav === "full") { %>
      <%~ include("/partials/bottom-nav", { bar: c.nav.bar, views: c.views, href: (view) => `/?view=${view}`, inboxCount: c.inboxCount }) %>
      <%~ include("/partials/more-views", { list: { view: c.lastView }, views: c.views, nav: c.nav, listQueryString: c.listQueryString, offHome: true }) %>
    <% } %>
  </main>
</body>
</html>
