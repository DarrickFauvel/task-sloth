<% layout("/layout") %>
<%~ include("/partials/app-header", { user: it.user, membership: it.membership, line: it.householdLine, doneToday: it.doneToday }) %>
<% if (it.emailNotice) { %><%~ include("/partials/email-notice", it.emailNotice) %><% } %>
<%~ include("/partials/qr-dialog", it.qr) %>
<% if (it.membership) { %>
  <script type="module" src="/js/list-nav.js"></script>
  <script type="module" src="/js/near-you.js"></script>
  <script type="module" src="/js/quick-suggest.js"></script>
  <script type="module" src="/js/elapsed-time.js"></script>
  <%~ include("/partials/more-views", { list: it.list, views: it.views, nav: it.nav, listQueryString: it.listQueryString }) %>
  <%/* Outside the add form (its buttons mustn't submit it) and outside the live-updated parts. */%>
  <dialog id="shortcuts-dialog" class="sheet" aria-labelledby="shortcuts-title" closedby="any"
          data-on:click="evt.target === el && el.close()">
    <div class="sheet-body">
      <h2 id="shortcuts-title">Shortcuts you can type</h2>
      <p class="hint">Tap one to add it to your task, or type it yourself.</p>
      <%~ include("/partials/shortcuts", { ...it.shortcuts, insert: true }) %>
      <form method="dialog"><button class="button">Close</button></form>
    </div>
  </dialog>
  <%/* Live updates: retry 'always' also reconnects after the server ends the stream (e.g. a redeploy).
       since/next let the stream skip re-sending what this page already shows (see /events); whenShown waits
       out a prerender, so a page the browser only might open doesn't hold a stream.
       Switching lists (public/js/list-nav.js) opens a new stream for the new list, with no since, so it renders it
       at once; a new @get from this element cancels the old stream. The signals follow, since the add box and the
       rows' buttons post them. */%>
  <% const l = it.list; %>
  <div data-signals="{view: '<%= l.view %>', project: '<%= l.project ?? '' %>', context: '<%= l.context ?? '' %>', tag: '<%= l.tag ?? '' %>', quick: '', renaming: '', renameText: ''}"
       data-init="whenShown(() => @get('/events?<%= [it.listQueryString(l), `since=${it.renderedAt}`, l.refreshAt ? `next=${l.refreshAt}` : ''].filter(Boolean).join('&') %>', {retry: 'always', retryMaxCount: 1000, filterSignals: {include: /^$/}}))"
       data-on:click__window="const n = window.listNav?.fromClick(evt); n && ($view = n.view, $project = n.project, $context = n.context, $tag = n.tag, @get('/events?' + n.query, {retry: 'always', retryMaxCount: 1000, filterSignals: {include: /^$/}}))"
       data-on:popstate__window="const n = window.listNav?.fromLocation(); n && ($view = n.view, $project = n.project, $context = n.context, $tag = n.tag, @get('/events?' + n.query, {retry: 'always', retryMaxCount: 1000, filterSignals: {include: /^$/}}))">
    <form id="quick-add" class="quick-add" method="post" action="/tasks" data-on:submit="@post('/tasks')">
      <input type="hidden" name="view" value="<%= l.view %>">
      <input type="hidden" name="project" value="<%= l.project ?? '' %>">
      <input type="hidden" name="context" value="<%= l.context ?? '' %>">
      <input type="hidden" name="tag" value="<%= l.tag ?? '' %>">
      <%/* The × clears what's typed (so does Esc) and keeps the cursor in the box. It starts hidden;
           data-show reveals it once there's text. */%>
      <span class="input-wrap">
        <input name="quick" data-bind:quick required maxlength="300" autocomplete="off" autocapitalize="none" aria-label="New task"
               placeholder="Add a task…" data-on:keydown="evt.key === 'Escape' && $quick && (evt.preventDefault(), $quick = '')">
        <button type="button" class="clear-input" aria-label="Clear" style="display: none"
                data-show="$quick.length > 0" data-on:click="$quick = ''; el.previousElementSibling.focus()">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <%/* Suggests shortcuts while typing: @who / where, #project, +tag, when and repeats (public/js/quick-suggest.js). */%>
        <quick-suggest></quick-suggest>
      </span>
      <button type="button" class="icon-button help-button" aria-label="Shortcuts you can type" aria-haspopup="dialog"
              data-on:click="document.getElementById('shortcuts-dialog').showModal()">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
        </svg>
      </button>
      <button class="button primary">Add</button>
    </form>
    <%~ include("/partials/tabs", { list: l, views: it.views, nav: it.nav, listQueryString: it.listQueryString }) %>
    <%~ include("/partials/flash", it.flash ?? {}) %>
    <%/* "You're near Target" when this device has Near you on (public/js/near-you.js); outside the live parts. */%>
    <near-you></near-you>
    <%~ include("/partials/task-list", { ...l, userId: it.user.id, doneToday: it.doneToday }) %>
  </div>
  <% if (it.photosEnabled) { %><%~ include("/partials/photo-viewer", {}) %><% } %>

<% } else { %>
  <%~ include("/partials/flash", it.flash ?? {}) %>
  <section class="panel">
    <h2>Welcome, <%= it.user.name %></h2>
    <p>Start a household, or ask someone in yours for an invite link.</p>
    <form method="post" action="/household" class="stack">
      <label>Household name <input name="name" required maxlength="80" placeholder="Our home" autocomplete="off"></label>
      <button class="button primary">Create household</button>
    </form>
  </section>
<% } %>
