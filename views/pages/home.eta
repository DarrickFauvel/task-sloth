<% layout("/layout") %>
<header class="bar">
  <h1><a class="brand" href="/">Task Sloth</a></h1>
  <div class="bar-actions">
    <button type="button" class="icon-button" aria-label="Show a QR code to open this app on another phone" aria-haspopup="dialog"
            data-on:click="document.getElementById('qr-dialog').showModal()">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
        <path d="M14 14h3v3M21 14v.01M14 21h3M21 18v3M17 21h.01"/>
      </svg>
    </button>
    <a href="/help"><span class="narrow-only">Help</span><span class="wide-only">How it works</span></a>
    <form method="post" action="/logout"><button class="link">Sign out</button></form>
  </div>
</header>
<%~ include("/partials/qr-dialog", it.qr) %>
<% if (it.membership) { %>
  <%~ include("/partials/more-views", { list: it.list, views: it.views, nav: it.nav, listQueryString: it.listQueryString }) %>
  <%/* Outside the add form (its buttons mustn't submit it) and outside the live-updated parts. */%>
  <dialog id="shortcuts-dialog" class="sheet" aria-labelledby="shortcuts-title" closedby="any"
          data-on:click="evt.target === el && el.close()">
    <div class="sheet-body">
      <h2 id="shortcuts-title">Shortcuts you can type</h2>
      <p class="hint">Tap one to add it to your task, or type it yourself.</p>
      <%~ include("/partials/shortcuts", { ...it.shortcuts, insert: true }) %>
      <form method="dialog"><button class="button">Close</button></form>
    </div>
  </dialog>
  <%/* Live updates: retry 'always' also reconnects after the server ends the stream (e.g. a redeploy). */%>
  <% const l = it.list; %>
  <div data-signals="{view: '<%= l.view %>', context: '<%= l.context ?? '' %>', tag: '<%= l.tag ?? '' %>', quick: ''}"
       data-init="@get('/events?<%= it.listQueryString(l) %>', {retry: 'always', retryMaxCount: 1000, filterSignals: {include: /^$/}})">
    <form id="quick-add" class="quick-add" method="post" action="/tasks" data-on:submit="@post('/tasks')">
      <input type="hidden" name="view" value="<%= l.view %>">
      <input type="hidden" name="context" value="<%= l.context ?? '' %>">
      <input type="hidden" name="tag" value="<%= l.tag ?? '' %>">
      <%/* The × clears what's typed (so does Esc) and keeps the cursor in the box. It starts hidden;
           data-show reveals it once there's text. */%>
      <span class="input-wrap">
        <input name="quick" data-bind:quick required maxlength="300" autocomplete="off" aria-label="New task"
               placeholder="Add a task…" data-on:keydown="evt.key === 'Escape' && $quick && (evt.preventDefault(), $quick = '')">
        <button type="button" class="clear-input" aria-label="Clear" style="display: none"
                data-show="$quick.length > 0" data-on:click="$quick = ''; el.previousElementSibling.focus()">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </span>
      <button type="button" class="icon-button help-button" aria-label="Shortcuts you can type" aria-haspopup="dialog"
              data-on:click="document.getElementById('shortcuts-dialog').showModal()">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
        </svg>
      </button>
      <button>Add</button>
    </form>
    <%~ include("/partials/tabs", { list: l, views: it.views, nav: it.nav, listQueryString: it.listQueryString }) %>
    <div id="flash" role="status"></div>
    <%~ include("/partials/task-list", { ...l, userId: it.user.id }) %>
  </div>

  <details class="household">
    <summary><%= it.membership.household.name %> · <%= it.membership.members.length %> member<%= it.membership.members.length === 1 ? "" : "s" %></summary>
    <ul class="members">
      <% it.membership.members.forEach((m) => { %>
        <li><span class="dot" style="background: <%= m.color %>"></span><%= m.name %><%= m.id === it.user.id ? " (you)" : "" %></li>
      <% }) %>
    </ul>
    <div id="invite">
      <button data-on:click="@post('/household/invite')" data-indicator:inviting data-attr:disabled="$inviting">Invite someone</button>
    </div>
  </details>
<% } else { %>
  <section class="stack">
    <h2>Welcome, <%= it.user.name %></h2>
    <p>Start a household, or ask someone in yours for an invite link.</p>
    <form method="post" action="/household" class="stack">
      <label>Household name <input name="name" required maxlength="80" placeholder="Our home" autocomplete="off"></label>
      <button>Create household</button>
    </form>
  </section>
<% } %>
