<% layout("/layout", { title: "Activity" }) %>
<%/* What everyone in the household did over the last two weeks, newest first, one group per day. */%>
<a class="back" href="/">← All tasks</a>
<h1>Activity</h1>
<p class="hint">Everything that happened in <%= it.household %> over the last <%= it.days %> days.</p>
<% if (!it.activity.days.length) { %>
  <p class="empty">Nothing has happened in the last <%= it.days %> days.</p>
<% } %>
<% it.activity.days.forEach((d) => { %>
  <h3 class="group"><%= d.label %> <span class="count"><%= d.entries.length %></span></h3>
  <ul class="activity">
    <% d.entries.forEach((e) => { %>
      <li>
        <% if (e.actor) { %><%~ include("/partials/avatar", { user: e.actor }) %><% } else { %><span class="avatar activity-system" aria-hidden="true">↻</span><% } %>
        <span class="activity-text"><%= e.text %><% if (e.title) { %> <% if (e.href) { %><a href="<%= e.href %>">“<%= e.title %>”</a><% } else { %><s>“<%= e.title %>”</s><% } %><% } %></span>
        <time class="hint"><%= e.time %></time>
      </li>
    <% }) %>
  </ul>
<% }) %>
<% if (it.activity.capped) { %><p class="hint">Showing the latest <%= it.activity.count %>.</p><% } %>
