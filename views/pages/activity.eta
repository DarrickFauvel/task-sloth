<% layout("/layout", { title: "Activity", appNav: "full" }) %>
<%/* What the household did over the last two weeks, newest first: one card per day (header band like the rest of
     the app), each line tidied by buildActivity (src/web/activity-page.js): one line per person, task and day, and
     minor changes left out unless "Show every change" (?all=1). The chips pick whose: by default yours, or everyone
     but you ("Sam" in a household of two), Everyone, or one person (?who=, plain links). */%>
<a class="back" href="<%= it.chrome?.back.href ?? '/' %>">← <%= it.chrome?.back.label ?? 'All tasks' %></a>
<h1>Activity</h1>
<p class="hint">What happened in <%= it.household %> over the last <%= it.days %> days: one line per task each day.<%= it.activity.all ? "" : " Small changes, like notes, tags or checklist items, are left out." %></p>
<% if (it.activity.people.length) { %>
  <nav class="pills activity-people" aria-label="Whose activity">
    <% it.activity.people.forEach((p) => { %>
      <a class="pill<%= p.on ? ' is-on' : '' %>" href="<%= p.href %>"<%~ p.on ? ' aria-current="page"' : '' %>><%= p.label %></a>
    <% }) %>
  </nav>
<% } %>
<% if (!it.activity.days.length) { %>
  <p class="empty">Nothing<%= it.activity.all ? "" : " worth mentioning" %> in the last <%= it.days %> days.</p>
<% } %>
<div class="activity-days">
  <% it.activity.days.forEach((d) => { %>
    <section class="panel activity-day">
      <h2 class="card-title"><%= d.label %> <span class="count"><%= d.entries.length %></span></h2>
      <ul class="activity">
        <% d.entries.forEach((e) => { %>
          <li>
            <% if (e.actor) { %><%~ include("/partials/avatar", { user: e.actor }) %><% } else { %><span class="avatar activity-system" aria-hidden="true">↻</span><% } %>
            <span class="activity-text"><%= e.text %><% if (e.title) { %> <% if (e.href) { %><a href="<%= e.href %>">“<%= e.title %>”</a><% } else { %><s>“<%= e.title %>”</s><% } %><% } %>
              <% if (e.detail) { %><span class="activity-detail hint"><%= e.detail %></span><% } %></span>
            <time class="hint"><%= e.time %></time>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>
</div>
<p class="activity-toggle"><a href="<%= it.activity.toggleHref %>"><%= it.activity.all ? "Show only the main things" : "Show every change" %></a></p>
<% if (it.activity.capped) { %><p class="hint">Showing the latest <%= it.activity.count %> changes.</p><% } %>
