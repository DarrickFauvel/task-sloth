<% layout("/layout", { title: "About", appNav: "full" }) %>
<%/* What Task Sloth is and who made it. Open to everyone, signed in or not. */%>
<% if (it.chrome) { %><a class="back" href="<%= it.chrome?.back.href ?? '/' %>">← <%= it.chrome?.back.label ?? 'All tasks' %></a><% } else { %><a class="back" href="/"><%= it.user ? "← All tasks" : "← Home" %></a><% } %>
<article class="about">
  <img class="about-logo" src="<%= asset("/img/logo.png") %>" alt="" width="192" height="192">
  <h1>Task Sloth</h1>
  <p class="lead">A shared to-do list for your household. Jot things down fast, sort them later, and see only what you can actually do.</p>
  <% if (it.user) { %><p><a href="/help">How it works</a></p><% } %>
  <section class="panel about-credit">
    <h2>Made by</h2>
    <p><a href="https://darrickdevelops.com" rel="noopener">Darrick Develops</a></p>
  </section>
  <%/* Required by the icons' CC BY 4.0 license (PROJECT_ICONS in src/services/projects.js). */%>
  <p class="hint">Project logos from <a href="https://selfh.st/icons/" rel="noopener">selfh.st/icons</a>, used under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>.</p>
</article>
