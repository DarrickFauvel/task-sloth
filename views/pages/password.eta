<% layout("/layout", { title: it.reset ? "Choose a new password" : "Forgot your password?" }) %>
<%/* A forgotten password (src/services/email-confirm.js): ask for a link (it.forgot), the page saying one was sent
     (it.sent, the same whether or not there's an account), and where the link lands: a form for the new password
     (it.reset), or the link doesn't work anymore. You don't need to be signed in. */%>
<p class="brand-line"><%~ include("/partials/brand", {}) %></p>
<section class="panel">
  <% if (it.sent) { %>
    <h1>Check your email</h1>
    <p>If there's an account for <strong><%= it.identifier %></strong>, we've emailed it a link to choose a new password.</p>
    <p class="hint">The link works once, for the next hour. Nothing there? Check spam, or try your other email or your username.</p>
    <a class="button primary" href="/login">Back to sign in</a>

  <% } else if (it.forgot) { %>
    <h1>Forgot your password?</h1>
    <p class="hint">Type your username or email, and we'll email you a link to choose a new one.</p>
    <form method="post" action="/password/forgot" class="stack">
      <% if (it.error) { %><p class="flash is-error" role="alert"><%= it.error %></p><% } %>
      <label>Username or email
        <input name="identifier" value="<%= it.identifier ?? '' %>" required maxlength="254" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
      </label>
      <button class="button primary">Send me a link</button>
    </form>

  <% } else if (it.reset) { %>
    <h1>Choose a new password</h1>
    <p>For <strong>@<%= it.reset.username %></strong>. You'll be signed in, and signed out everywhere else.</p>
    <form method="post" action="/password/reset" class="stack">
      <input type="hidden" name="token" value="<%= it.token %>">
      <%/* The username, so a password manager files the new password under the right account. */%>
      <input type="text" name="username" value="<%= it.reset.username %>" autocomplete="username" hidden>
      <% if (it.error) { %><p class="flash is-error" role="alert"><%= it.error %></p><% } %>
      <label>New password
        <input type="password" name="password" required minlength="8" maxlength="200" autocomplete="new-password" autofocus>
        <small class="hint">At least 8 characters.</small>
      </label>
      <label>Type it again <input type="password" name="again" required minlength="8" maxlength="200" autocomplete="new-password"></label>
      <button class="button primary">Save new password</button>
    </form>

  <% } else { %>
    <h1>This link doesn't work anymore</h1>
    <p><%= it.error ?? "It has expired or was already used. Reset links work once, for an hour." %></p>
    <a class="button primary" href="/password/forgot">Send a new link</a>
  <% } %>
</section>
<p class="panel-links"><a href="/login">Sign in</a> · <a href="/signup">Create an account</a></p>
