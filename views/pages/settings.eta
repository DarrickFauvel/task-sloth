<% layout("/layout", { title: "Settings", appNav: "full" }) %>
<script type="module" src="<%= asset("/js/photo-picker.js") %>"></script>
<%/* Profile, appearance, household and account: one card each. Everything saves as you go (the name when you
     leave its box, a color or theme when you pick it, a photo once chosen); the household name is the only
     field with a Save button. A fieldset groups the choices that answer one question (photo, color, theme).
     Where / how (places) is in the account menu; changing how you sign in folds away under Account. */%>
<% const u = it.user; %>
<div class="settings-page">
<a class="back" href="<%= it.chrome?.back.href ?? '/' %>">← <%= it.chrome?.back.label ?? 'All tasks' %></a>
<h1>Settings</h1>
<%/* Saved messages are toasts; errors too, except the sign-in form's, which show in its card. */%>
<% const pageError = it.signIn ? null : it.error; %>
<%~ include("/partials/flash", { message: it.saved ?? pageError, error: Boolean(pageError) }) %>

<div class="settings">
  <section class="panel" aria-labelledby="profile-title">
    <h2 id="profile-title"><span class="emoji" aria-hidden="true">👤</span> Profile</h2>

    <%/* <photo-picker> shrinks the picked image and saves it at once (it needs script); removing it is a plain
         form. Both sit outside the name/color form. */%>
    <fieldset class="profile-photo">
      <legend class="visually-hidden">Your photo</legend>
      <div class="profile-preview"><%~ include("/partials/avatar", { user: u, size: "lg" }) %></div>
      <div class="profile-photo-actions">
        <photo-picker action="/settings/photo">
          <label class="button"><input type="file" accept="image/*" class="visually-hidden"><%= u.avatar_photo_at ? "Change photo" : "Add a photo" %></label>
          <p class="hint" role="status" hidden></p>
        </photo-picker>
        <% if (u.avatar_photo_at) { %>
          <form method="post" action="/settings/photo/remove"><button class="link danger">Remove</button></form>
        <% } else { %>
          <span class="hint">Otherwise we show your initial.</span>
        <% } %>
      </div>
    </fieldset>

    <%/* The name saves when you leave its box (Enter leaves it too), the color when you pick one. "Save profile"
         is only for when script is off; data-show hides it once Datastar is running. */%>
    <form method="post" action="/settings/profile" class="stack" data-on:submit="document.activeElement?.blur()">
      <label class="field">Your name
        <%/* data-bind starts the $name signal from this value; the server sends it back tidied (or restored after an error). */%>
        <input name="name" value="<%= u.name %>" required maxlength="60" autocomplete="name"
               data-bind:name data-on:change="@post('/settings/name')">
        <small class="hint">Shown next to your tasks. Saves as you leave the box.</small>
      </label>
      <%/* Picking a color takes effect straight away: the app's accent and your avatars on this page change to
           it, and it saves in the background. */%>
      <fieldset class="field" data-signals="{color: '<%= u.color %>'}"
                data-on:change="$color = evt.target.value; document.documentElement.style.setProperty('--you', $color); document.querySelectorAll('.avatar').forEach((a) => a.dataset.member === '<%= u.id %>' && a.style.setProperty('--c', $color)); @post('/settings/color')">
        <legend>Your color</legend>
        <div class="pills swatches">
          <% it.colors.forEach((c) => { %>
            <label class="pill swatch"><input type="radio" name="color" value="<%= c %>"<%~ c === u.color ? " checked" : "" %>><span style="--c: <%= c %>" title="<%= it.colorNames[c] %>" aria-label="<%= it.colorNames[c] %>"></span></label>
          <% }) %>
        </div>
        <small class="hint">Your avatar and the app's highlight color.</small>
      </fieldset>
      <button class="button primary" data-show="false">Save profile</button>
    </form>
  </section>

  <section class="panel" aria-labelledby="appearance-title">
    <h2 id="appearance-title"><span class="emoji" aria-hidden="true">🎨</span> Appearance</h2>
    <form method="post" action="/settings/theme">
      <fieldset class="field">
        <legend>Theme</legend>
        <div class="pills">
          <% [["system", "Match my device"], ["light", "Light"], ["dark", "Dark"]].forEach(([value, label]) => { %>
            <%/* Switches in place with the same soft animation (setTheme in the layout), then posts for the "saved" toast;
                 without script, it's the plain form post. */%>
            <button name="theme" value="<%= value %>" data-theme-choice="<%= value %>" class="pill<%= (it.theme ?? 'system') === value ? ' is-on' : '' %>"
                    data-on:click__prevent="setTheme(<%= value === 'system' ? 'null' : `'${value}'` %>, el); @post('/settings/theme?theme=<%= value %>')"><%= label %></button>
          <% }) %>
        </div>
      </fieldset>
    </form>
    <form method="post" action="/settings/icons">
      <fieldset class="field">
        <legend>Icons</legend>
        <div class="pills">
          <% [["on", "Show"], ["off", "Hide"]].forEach(([value, label]) => { %>
            <%/* Switches in place (setIcons in the layout), then posts for the toast; without script, it's the form post. */%>
            <button name="icons" value="<%= value %>" data-icons-choice="<%= value %>" class="pill<%= (it.icons ?? 'on') === value ? ' is-on' : '' %>"
                    data-on:click__prevent="setIcons(<%= value === 'on' %>); @post('/settings/icons?icons=<%= value %>')"><%= label %></button>
          <% }) %>
        </div>
        <small class="hint">The little pictures beside headings and menus.</small>
      </fieldset>
    </form>
    <%/* Theme and icons are cookies, unlike name and color, which follow the account. */%>
    <p class="hint">Saved on this device only.</p>
  </section>

  <% if (it.membership) { const m = it.membership; const owner = m.members.find((p) => p.id === m.ownerId); %>
    <section class="panel" aria-labelledby="household-title">
      <h2 id="household-title"><span class="emoji" aria-hidden="true">🏠</span> Household</h2>
      <%/* Only the person who set up the household can rename it. */%>
      <% if (m.ownerId === u.id) { %>
        <form method="post" action="/settings/household">
          <label class="field">Household name
            <span class="inline-field">
              <input name="name" value="<%= m.household.name %>" required maxlength="80" autocomplete="off">
              <button class="button">Save</button>
            </span>
          </label>
        </form>
      <% } else { %>
        <div class="field">
          <span>Household name</span>
          <strong><%= m.household.name %></strong>
          <small class="hint">Only <%= owner?.name ?? "the person who set it up" %> can rename it.</small>
        </div>
      <% } %>
      <div class="field">
        <h3 class="field-title">Members <span class="count">· <%= m.members.length %></span></h3>
        <ul class="members">
          <% m.members.forEach((p) => { %>
            <li>
              <%~ include("/partials/avatar", { user: p }) %>
              <span class="member-name"><%= p.name %><% if (p.id === u.id) { %> <span class="hint">(you)</span><% } %></span>
              <% if (p.id === m.ownerId) { %><span class="member-note">Set it up</span><% } %>
            </li>
          <% }) %>
        </ul>
      </div>
      <div id="invite">
        <button class="button" data-on:click="@post('/household/invite')" data-indicator:inviting data-attr:disabled="$inviting">Invite someone</button>
      </div>
    </section>
  <% } %>

  <section class="panel" aria-labelledby="account-title">
    <h2 id="account-title"><span class="emoji" aria-hidden="true">🔑</span> Account</h2>
    <% if (u.username) { /* a password account: username and email are yours to change */ %>
      <% const f = it.signIn ?? { username: u.username, email: u.email }; %>
      <%/* Where the email stands. A new email only takes over once its link is opened (src/services/email-confirm.js).
           These are their own small forms, outside the sign-in form. */%>
      <% if (u.pending_email) { %>
        <div class="email-status is-pending">
          <p>Waiting for you to confirm <strong><%= u.pending_email %></strong>. Open the link we sent there. Until then, you sign in with <%= u.email %>.</p>
          <div class="email-status-actions">
            <form method="post" action="/email/resend"><button class="link">Send the link again</button></form>
            <form method="post" action="/email/cancel"><button class="link danger">Cancel change</button></form>
          </div>
        </div>
      <% } else if (!u.email_verified_at) { %>
        <div class="email-status is-pending">
          <p>Your email isn't confirmed yet.<% if (it.emailLinkOut) { %> Open the link we sent to <strong><%= u.email %></strong>.<% } else { %> We'll send a link to <strong><%= u.email %></strong>.<% } %></p>
          <div class="email-status-actions">
            <form method="post" action="/email/resend"><button class="link"><%= it.emailLinkOut ? "Send the link again" : "Send me a link" %></button></form>
          </div>
        </div>
      <% } %>
      <%/* What you sign in with, at a glance; changing it is folded away (five fields) and opens after an error. */%>
      <dl class="account">
        <dt>Username</dt><dd><%= u.username %></dd>
        <dt>Email</dt><dd><%= u.email %></dd>
      </dl>
      <details class="change-sign-in"<%~ it.signIn ? " open" : "" %>>
        <summary>Change username, email or password</summary>
      <form method="post" action="/settings/sign-in" class="stack">
        <fieldset class="field sign-in-fields">
          <legend class="visually-hidden">How you sign in</legend>
          <label class="field">Username
            <input name="username" value="<%= f.username %>" required minlength="3" maxlength="30" pattern="[A-Za-z0-9_.\-]{3,30}"
                   autocomplete="username" autocapitalize="off" spellcheck="false">
            <small class="hint">3–30 letters, numbers, dots, dashes or underscores.</small>
          </label>
          <label class="field">Email
            <input type="email" name="email" value="<%= f.email %>" required maxlength="254" autocomplete="email">
            <small class="hint"><%= u.email_verified_at && !u.pending_email ? "✓ Confirmed. " : "" %>A new email changes once you open the link we send to it.</small>
          </label>
          <%/* Optional: blank keeps the password. "Type it again" shows once something's typed (CSS :has on the
               placeholder), and a change signs out your other devices (see updateSignIn). */%>
          <label class="field"><span>New password <span class="hint">(optional)</span></span>
            <input type="password" name="newPassword" minlength="8" maxlength="200" autocomplete="new-password" placeholder=" ">
            <small class="hint">Leave it blank to keep your password. At least 8 characters; your other devices get signed out.</small>
          </label>
          <label class="field new-password-again">Type it again
            <input type="password" name="newPasswordAgain" minlength="8" maxlength="200" autocomplete="new-password">
          </label>
          <label class="field">Current password
            <%/* After an error the page reloads at the top; focusing here scrolls back to the form and its message. */%>
            <input type="password" name="password" required autocomplete="current-password"<%~ it.signIn && it.error ? " autofocus" : "" %>>
            <small class="hint">To make sure it's you.</small>
          </label>
        </fieldset>
        <% if (it.signIn && it.error) { %><p class="flash is-error" role="alert"><%= it.error %></p><% } %>
        <button class="button primary">Save changes</button>
      </form>
      </details>
    <% } else { /* Google (or dev) sign-in: Google owns the email, and there's no username */ %>
      <dl class="account">
        <dt>Email</dt><dd><%= u.email %> <span class="hint">· from Google</span></dd>
      </dl>
    <% } %>
    <form method="post" action="/logout"><button class="button">Sign out</button></form>
  </section>
</div>
</div>
