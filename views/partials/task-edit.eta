<%/* it.form is the edit form data (see src/web/task-page.js), or null when not editing. Empty unless editing.
     It sits outside #task-head, so live updates never touch a form that's being filled in.
     Grouped like the rest of the app (When, Who, Where…), with chips instead of dropdowns where the
     choices are few, and Save/Cancel pinned to the bottom of the screen. Field names are unchanged. */%>
<div id="task-edit" data-show="$editing">
<% if (it.form) { const f = it.form; const t = f.task; const checked = (on) => (on ? " checked" : ""); %>
  <form class="edit" method="post" action="/tasks/<%= t.id %>/edit" data-on:submit="@post('/tasks/<%= t.id %>/edit', {contentType: 'form'})">
    <section class="edit-main">
      <label for="edit-title" class="hint">Task</label>
      <input id="edit-title" class="edit-title" name="title" value="<%= t.title %>" required maxlength="300" autocomplete="off">
      <textarea name="notes" rows="2" maxlength="10000" aria-label="Notes" placeholder="Add notes…"><%= t.notes %></textarea>
    </section>

    <section class="edit-group">
      <h3><span aria-hidden="true">📅</span> When</h3>
      <div class="pills" role="group" aria-label="Quick dates">
        <% f.quickDates.forEach((d) => { %>
          <button type="button" class="pill" data-on:click="el.form.elements.dueDate.value = '<%= d.date %>'"><%= d.label %></button>
        <% }) %>
        <button type="button" class="pill" data-on:click="el.form.elements.dueDate.value = ''; el.form.elements.dueTime.value = ''">No date</button>
      </div>
      <div class="edit-row is-when">
        <label>Date <input type="date" name="dueDate" value="<%= t.due_date ?? '' %>"></label>
        <label>Time <input type="time" name="dueTime" value="<%= t.due_time ?? '' %>"></label>
      </div>
      <fieldset class="pills">
        <legend>Repeats</legend>
        <% f.repeats.forEach((r) => { %>
          <label class="pill"><input type="radio" name="recurrence" value="<%= r.value %>"<%~ checked(r.value === f.currentRepeat) %>><span><%= r.label %></span></label>
        <% }) %>
      </fieldset>
    </section>

    <section class="edit-group">
      <h3><span aria-hidden="true">👤</span> Who</h3>
      <fieldset class="pills">
        <legend class="visually-hidden">Who does it</legend>
        <% f.members.forEach((m) => { %>
          <label class="pill"><input type="radio" name="assigneeId" value="<%= m.id %>"<%~ checked(m.id === t.assignee_id) %>><span><%= m.id === f.userId ? "Me" : m.name %></span></label>
        <% }) %>
        <label class="pill"><input type="radio" name="assigneeId" value=""<%~ checked(!t.assignee_id) %>><span>Anyone</span></label>
      </fieldset>
    </section>

    <section class="edit-group">
      <h3><span aria-hidden="true">📍</span> Where / how <span class="hint">· and tags</span></h3>
      <div class="edit-row is-stacked">
        <label>Where / how
          <input name="context" value="<%= t.context_name ?? '' %>" list="contexts" maxlength="80" autocomplete="off" placeholder="e.g. Target, phone">
        </label>
        <label>Tags
          <input name="tags" value="<%= f.tags %>" maxlength="300" autocomplete="off" placeholder="e.g. errand kids">
        </label>
      </div>
      <datalist id="contexts">
        <% f.contexts.forEach((c) => { %><option value="<%= c.name %>"></option><% }) %>
      </datalist>
    </section>

    <section class="edit-group">
      <h3><span aria-hidden="true">📥</span> List</h3>
      <fieldset class="pills">
        <legend class="visually-hidden">Which list it's on</legend>
        <% f.lists.forEach((o) => { %>
          <label class="pill"><input type="radio" name="list" value="<%= o.value %>"<%~ checked(o.value === t.list) %>><span><%= o.label %></span></label>
        <% }) %>
      </fieldset>
      <%/* Shown only while "Waiting on" is picked (CSS :has, no script). */%>
      <label class="waiting-field">Waiting on who or what?
        <input name="waitingOn" value="<%= t.waiting_on ?? '' %>" maxlength="200" autocomplete="off" placeholder="e.g. the plumber">
      </label>
      <%/* Blocked by another task: it stays on its list, marked ⏳, until that task is done. */%>
      <label>Blocked by another task
        <select name="waitingTaskId">
          <option value="">Nothing, ready when you are</option>
          <% f.blockers.forEach((b) => { %>
            <option value="<%= b.id %>"<%~ b.id === t.waiting_task_id ? " selected" : "" %>><%= b.title %></option>
          <% }) %>
          <option value="new">➕ New task…</option>
        </select>
        <span class="hint">It'll show ⏳ until that task is done, then it's ready to go (back on To do, if it was on Waiting on).</span>
      </label>
      <%/* Shown only while "➕ New task…" is picked (CSS :has). Shortcuts work: "patch the walls sat @sam". */%>
      <label class="new-blocker">New task to do first
        <input name="newBlocker" maxlength="300" autocomplete="off" placeholder="e.g. patch the walls sat">
        <span class="hint">Shortcuts work here too. It goes on To do, in the same project as this one.</span>
      </label>
    </section>

    <section class="edit-group">
      <h3><span aria-hidden="true">❗</span> Priority</h3>
      <fieldset class="pills">
        <legend class="visually-hidden">Priority</legend>
        <% f.priorities.forEach((p) => { %>
          <label class="pill"><input type="radio" name="priority" value="<%= p.value %>"<%~ checked(Number(t.priority) === p.value) %>><span><%= p.label %></span></label>
        <% }) %>
      </fieldset>
    </section>

    <section class="edit-group">
      <h3><span aria-hidden="true">📁</span> Project</h3>
      <select name="projectId" aria-label="Project">
        <option value="">No project</option>
        <% f.projects.forEach((p) => { %>
          <option value="<%= p.id %>"<%~ p.id === t.project_id ? " selected" : "" %>><%= p.emoji %> <%= p.name %></option>
        <% }) %>
      </select>
    </section>

    <div class="edit-actions">
      <a class="button" href="/tasks/<%= t.id %>" data-on:click__prevent="$editing = false">Cancel</a>
      <button class="button primary">Save</button>
    </div>
  </form>
<% } %>
</div>
