<section id="task-list">
  <% if (!it.groups.length && it.filterLabel) { %>
    <p class="empty">No <%= it.view === "done" ? "finished" : "open" %> tasks for <%= it.filterLabel %> here.</p>
  <% } else if (!it.groups.length) { %>
    <p class="empty"><%= {
      inbox: "All sorted 🎉 Nothing waiting in your inbox.",
      mine: "Nothing on your plate. Nice.",
      all: "No open tasks. Add one above.",
      grabs: "Nothing up for grabs.",
      waiting: "Not waiting on anyone right now.",
      someday: "Nothing parked here yet. When an idea isn't for now, sort it into “Maybe later”.",
      done: "Nothing finished yet.",
    }[it.view] %></p>
  <% } %>
  <% it.groups.forEach((g) => { %>
    <%/* By date, or by where/how (each place's heading links to just its tasks). */%>
    <h3 class="group <%= it.groupBy === 'when' && g.label === 'Overdue' ? 'overdue' : '' %>"><% if (g.contextId) { %><a href="/?<%= new URLSearchParams({ view: it.view, context: g.contextId, ...(it.tag ? { tag: it.tag } : {}) }) %>">@<%= g.label %></a><% } else { %><%= g.label %><% } %> <span class="count"><%= g.tasks.length %></span></h3>
    <ul class="tasks">
      <% g.tasks.forEach((t) => { %>
        <%~ include("/partials/task-row", { t, view: it.view, context: it.context, tag: it.tag, userId: it.userId }) %>
      <% }) %>
    </ul>
  <% }) %>
</section>
