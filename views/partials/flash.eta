<div id="flash" role="status" class="flash<%= it.error ? ' is-error' : '' %>">
  <span><%= it.message %></span>
  <% if (it.link) { %><a href="<%= it.link.href %>"><%= it.link.label %></a><% } %>
  <% if (it.undo) { %>
    <button class="link" data-on:click="@post('<%= it.undo %>')">Undo</button>
  <% } %>
</div>
