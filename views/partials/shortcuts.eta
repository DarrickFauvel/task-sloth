<%/* The quick-add cheat sheet (rows from src/web/shortcuts.js). In the home page's drawer (it.insert)
     each example is a button that adds it to the task being typed; on the How it works page it's plain text.
     Tokens can include members' names, so they are only ever output with escaping. */%>
<% if (it.insert) { %>
  <%/* The drawer: what it's for first, then the examples to tap. */%>
  <div class="shortcut-picker">
    <% it.rows.forEach((r) => { %>
      <div class="shortcut-row">
        <p><%= r.what %></p>
        <div class="tokens">
          <% r.tokens.forEach((t) => { %><button type="button" class="token" data-token="<%= t %>" data-on:click="<%= it.insertJs %>"><%= t %></button><% }) %>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <dl class="shortcuts">
    <% it.rows.forEach((r) => { %>
      <dt><% r.tokens.forEach((t, i) => { %><%= i ? ", " : "" %><code><%= t %></code><% }) %></dt>
      <dd><%= r.what %></dd>
    <% }) %>
  </dl>
<% } %>
<% if (it.insert) { %>
  <p class="hint">Or try a whole one:
    <button type="button" class="token" data-token="<%= it.example %>" data-on:click="<%= it.insertJs %>"><%= it.example %></button>
  </p>
<% } else { %>
  <p class="hint">Example: <code><%= it.example %></code>. Anything with none of these goes to your Inbox to sort later.</p>
<% } %>
