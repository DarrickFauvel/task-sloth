<%/* The quick-add cheat sheet, grouped (see src/web/shortcuts.js). In the home page's drawer (it.insert)
     each example is a button that adds it to the task being typed; on the How it works page it's plain text.
     Tokens can include members' names, so they are only ever output with escaping. */%>
<div class="shortcut-groups">
  <% it.groups.forEach((g) => { %>
    <section class="shortcut-group">
      <h3><span class="emoji" aria-hidden="true"><%= g.icon %></span> <%= g.title %><% if (g.note) { %> <span class="hint">· <%= g.note %></span><% } %></h3>
      <% g.rows.forEach((r) => { %>
        <div class="shortcut-row<%= r.label ? '' : ' no-label' %>">
          <% if (r.label) { %><span class="shortcut-label"><%= r.label %></span><% } %>
          <span class="tokens">
            <% r.tokens.forEach((t) => { %>
              <% if (it.insert) { %><button type="button" class="token" data-token="<%= t %>" data-on:click="<%= it.insertJs %>"><%= t %></button><% } else { %><code class="token"><%= t %></code><% } %>
            <% }) %>
          </span>
        </div>
      <% }) %>
    </section>
  <% }) %>
</div>
<% if (it.insert) { %>
  <p class="hint shortcut-example">Or try a whole one:
    <button type="button" class="token" data-token="<%= it.example %>" data-on:click="<%= it.insertJs %>"><%= it.example %></button>
  </p>
<% } else { %>
  <p class="hint shortcut-example">Example: <code><%= it.example %></code>. Anything with none of these goes to your Inbox to sort later.</p>
<% } %>
