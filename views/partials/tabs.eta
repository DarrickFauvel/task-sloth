<%/* Re-rendered with the list on every change, so the Inbox count stays current.
     Desktop shows every view as a tab; phones get the bottom bar (see partials/more-views for "More"). */%>
<% const l = it.list; const href = (view) => `/?${it.listQueryString({ ...l, view })}`; %>
<% const current = (view) => (view === l.view ? ' aria-current="page"' : ""); %>
<% const badge = () => (l.inboxCount ? `<span class="badge">${l.inboxCount}</span>` : ""); %>
<% const inMore = it.nav.more.some((m) => m.view === l.view); %>
<div id="tabs">
  <nav class="tabs" aria-label="Lists">
    <% Object.entries(it.views).forEach(([key, label]) => { %>
      <a href="<%= href(key) %>"<%~ current(key) %>><%= label %><% if (key === "inbox") { %> <%~ badge() %><% } %></a>
    <% }) %>
  </nav>
  <nav class="bottom-nav" aria-label="Lists">
    <% it.nav.bar.forEach((key) => { %>
      <a href="<%= href(key) %>"<%~ current(key) %>>
        <span class="nav-icon"><%~ include("/partials/nav-icon", { name: key }) %><% if (key === "inbox") { %><%~ badge() %><% } %></span>
        <span><%= key === "all" ? "Everyone" : it.views[key] %></span>
      </a>
    <% }) %>
    <button type="button" aria-haspopup="dialog"<%~ inMore ? ' aria-current="page"' : "" %>
            data-on:click="document.getElementById('more-views').showModal()">
      <span class="nav-icon"><%~ include("/partials/nav-icon", { name: "more" }) %></span>
      <span>More</span>
    </button>
  </nav>
  <%/* On a phone the bar can't name a view that's under "More", so say it here. */%>
  <% if (inMore) { %><h2 class="view-title"><%= it.views[l.view] %></h2><% } %>
  <% if (l.hint) { %><p class="hint tab-hint"><%= l.hint %></p><% } %>
  <%/* To-do tabs: group by date or by where/how. A plain form: the choice is a cookie (see /list-grouping). */%>
  <% if (l.canGroup) { %>
    <form method="post" action="/list-grouping" class="pills grouping" aria-label="Group tasks by">
      <input type="hidden" name="view" value="<%= l.view %>"><input type="hidden" name="tag" value="<%= l.tag ?? '' %>">
      <span class="hint">Group by</span>
      <% [["when", "When"], ["where", "Where / how"]].forEach(([value, label]) => { %>
        <button name="by" value="<%= value %>" class="pill<%= l.groupBy === value ? ' is-on' : '' %>"<%~ l.groupBy === value ? ' aria-pressed="true"' : ' aria-pressed="false"' %>><%= label %></button>
      <% }) %>
    </form>
  <% } %>
  <% if (l.view === "inbox" && l.inboxCount) { %>
    <p><a class="button primary" href="/sort">Sort my inbox (<%= l.inboxCount %>)</a></p>
  <% } %>
  <% if (l.filterLabel) { %>
    <p class="filter">Only <strong><%= l.filterLabel %></strong> <a href="/?view=<%= l.view %>">Show all</a></p>
  <% } %>
</div>
