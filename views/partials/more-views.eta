<%/* The phone bar's "More" sheet: the views that don't fit in the bar, each with a few words on what it's for.
     It sits outside #tabs so a live update can't close it while it's open. Off home (it.offHome) no list is on
     screen, so none is marked. Projects is its own page, so it's never marked either. */%>
<% const l = it.list; %>
<dialog id="more-views" class="sheet" aria-labelledby="more-views-title" closedby="any"
        data-on:click="evt.target === el && el.close()">
  <div class="sheet-body">
    <h2 id="more-views-title">More lists</h2>
    <ul class="more-list">
      <% it.nav.more.forEach(({ view, blurb }) => { %>
        <li>
          <a href="/?<%= it.listQueryString({ ...l, view }) %>"<%~ view === l.view && !it.offHome ? ' aria-current="page"' : "" %>>
            <strong><%= it.views[view] %></strong>
            <span class="hint"><%= blurb %></span>
          </a>
        </li>
      <% }) %>
      <li>
        <a href="/projects">
          <strong>Projects</strong>
          <span class="hint">Bigger jobs, and how far along each one is</span>
        </a>
      </li>
      <li>
        <a href="/focus">
          <strong>Focus</strong>
          <span class="hint">Work through one project or place, a task at a time</span>
        </a>
      </li>
    </ul>
    <form method="dialog"><button class="button">Close</button></form>
  </div>
</dialog>
