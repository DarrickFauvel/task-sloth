<%/* The photo viewer: a full-screen modal that /js/photo-viewer.js fills and opens when a [data-photos] link is
     tapped (a task row's 📷 count, or a thumbnail on the task page). It sits outside the live-updated parts,
     so a re-render can't close it. Without script, those links just go to the task or the photo. */%>
<dialog id="photo-viewer" class="photo-viewer" aria-label="Photos" closedby="any">
  <figure class="viewer-stage">
    <img alt="">
  </figure>
  <p class="viewer-count" aria-live="polite"></p>
  <%/* A button per photo, filled in by the script; hidden when there's only one. */%>
  <nav class="viewer-strip" aria-label="All photos"></nav>
  <button type="button" class="viewer-button viewer-close" aria-label="Close" data-viewer="close">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <button type="button" class="viewer-button viewer-prev" aria-label="Previous photo" data-viewer="prev">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
  </button>
  <button type="button" class="viewer-button viewer-next" aria-label="Next photo" data-viewer="next">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  </button>
</dialog>
<script type="module" src="<%= asset("/js/photo-viewer.js") %>"></script>
