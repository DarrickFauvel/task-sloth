<% const t = it.t; const done = t.status === "done"; const action = done ? "reopen" : "done"; %>
<%/* Tap the title for the full task; tap ✏️ to rename it in place. While renaming, the text lives in
     $renameText (not just the input), so a live re-render of the list can't wipe a half-typed name. */%>
<% const renaming = `$renaming === '${t.id}'`; %>
<li class="task<%= done ? ' is-done' : '' %><%= t.priority > 0 ? ' is-high' : '' %><%= t.blockedBy && !done ? ' is-blocked' : '' %>" id="task-<%= t.id %>">
  <form method="post" action="/tasks/<%= t.id %>/<%= action %>" data-on:submit="@post('/tasks/<%= t.id %>/<%= action %>')">
    <input type="hidden" name="view" value="<%= it.view %>"><%~ include("/partials/list-query", it) %>
    <button class="check" aria-label="<%= done ? 'Mark not done' : 'Mark done' %>"><span aria-hidden="true">✓</span></button>
  </form>
  <div class="task-body" data-show="!(<%= renaming %>)">
    <a class="task-title" href="/tasks/<%= t.id %>"><span><%= t.title %></span></a>
    <span class="meta">
      <% if (t.worker) { %><span class="working"><span class="dot" style="background: <%= t.worker.color %>"></span><%= t.worker.id === it.userId ? "You're on it" : `${t.worker.name.split(" ")[0]}'s on it` %></span><% } %>
      <% if (t.dueLabel) { %><span class="due <%= t.dueState %>"><%= t.dueText %></span><% } %>
      <% if (t.repeats) { %><span title="Repeats">↻ <%= t.repeats %></span><% } %>
      <% if (t.blockedBy && !done) { %><span class="blocked" title="Blocked until this is done">⏳ after “<%= t.blockedBy %>”</span><% } %>
      <% if (t.waitingLabel) { %><span title="Waiting on">⏳ <%= t.waitingLabel %></span><% } %>
      <% if (t.blocking.length && !done) { %><span title="Waiting on this">🔗 holding up <%= t.blocking.length %></span><% } %>
      <% if (t.project_name) { %><a class="chip project" style="--c: <%= t.project_color %>" href="/?view=all&project=<%= t.project_id %>" title="All open tasks in <%= t.project_name %>"><%= t.project_emoji %> <%= t.project_name %></a><% } %>
      <%~ include("/partials/context-tags", { t }) %>
      <% t.phones.forEach((phone) => { /* the title is already a link, so the number gets its own */ %>
        <a class="chip phone" href="<%= phone.tel %>" title="Call <%= phone.text %>">📞 <%= t.phones.length > 1 ? phone.text : "Call" %></a>
      <% }) %>
      <% if (Number(t.item_count)) { %><span title="Checklist">☑ <%= t.item_done %>/<%= t.item_count %></span><% } %>
      <% if (t.photoIds.length) { /* up to 3 overlapping thumbnails (+ how many more); opens the photo viewer, or the task page without script */ %>
        <% const n = Number(t.photo_count); %>
        <a class="photo-stack" href="/tasks/<%= t.id %>#task-photos" data-photos="/tasks/<%= t.id %>/photos"
           aria-label="See <%= n %> photo<%= n === 1 ? '' : 's' %>" title="See photos">
          <%/* data-index: the viewer opens on the photo tapped; "+k" opens on the first one not shown here. */%>
          <% t.photoIds.forEach((id, i) => { %><img src="/photos/<%= id %>/tiny" alt="" width="24" height="24" loading="lazy" data-index="<%= i %>"><% }) %>
          <% if (n > t.photoIds.length) { %><span class="photo-more" data-index="<%= t.photoIds.length %>">+<%= n - t.photoIds.length %></span><% } %>
        </a>
      <% } %>
      <%/* A dot when someone else commented since you last opened the task. */%>
      <% if (Number(t.comment_count)) { %><span title="<%= t.newComments ? 'New comments' : 'Comments' %>"<%~ t.newComments ? ' class="has-new"' : '' %>>💬 <%= t.comment_count %><% if (t.newComments) { %><span class="new-dot" aria-hidden="true"></span><span class="visually-hidden"> new</span><% } %></span><% } %>
      <% if (it.view === "inbox") { %>
        <a href="/sort?task=<%= t.id %>">Sort</a>
      <% } else if (!done && (t.list === "waiting" || t.list === "someday")) { %>
        <form method="post" action="/tasks/<%= t.id %>/list/todo" data-on:submit="@post('/tasks/<%= t.id %>/list/todo')" class="inline">
          <input type="hidden" name="view" value="<%= it.view %>"><%~ include("/partials/list-query", it) %>
          <button class="link" title="Move to the To do list">Ready to do →</button>
        </form>
      <% } %>
      <% if (done && it.view !== "done") { /* finished tasks linger a few minutes; this clears one now */ %>
        <form method="post" action="/tasks/<%= t.id %>/hide" data-on:submit="leaveThen(el.closest('li'), () => @post('/tasks/<%= t.id %>/hide'))" class="inline">
          <input type="hidden" name="view" value="<%= it.view %>"><%~ include("/partials/list-query", it) %>
          <button class="link" title="Take it off this list now. It's still in Done.">Hide</button>
        </form>
      <% } %>
      <%/* "Working on now": Start puts it at the top of everyone's lists (one task each at a time); Stop takes it off.
           Rows offer Start on your tasks and nobody's; helping with someone else's starts from its page. */%>
      <% const working = t.worker && t.worker.id === it.userId;
         const canStart = !t.worker && t.list === "todo" && !t.blockedBy && (!t.assignee || t.assignee.id === it.userId); %>
      <% if (!done && it.view !== "inbox" && (working || canStart)) { %>
        <form method="post" action="/tasks/<%= t.id %>/<%= working ? 'stop' : 'start' %>" data-on:submit="@post('/tasks/<%= t.id %>/<%= working ? 'stop' : 'start' %>')" class="inline">
          <input type="hidden" name="view" value="<%= it.view %>"><%~ include("/partials/list-query", it) %>
          <button class="link" title="<%= working ? 'Not doing it right now after all' : 'Show everyone you’re doing this right now' %>"><%= working ? "Stop" : "Start" %></button>
        </form>
      <% } %>
      <% if (it.view === "inbox") { /* it's yours until it's sorted */ %>
      <% } else if (t.assignee && t.assignee.id === t.worker?.id) { /* "Sam's on it" already says whose it is */ %>
      <% } else if (t.assignee) { %>
        <span class="who"><span class="dot" style="background: <%= t.assignee.color %>"></span><%= t.assignee.id === it.userId ? "Me" : t.assignee.name %></span>
      <% } else if (!done) { %>
        <form method="post" action="/tasks/<%= t.id %>/claim" data-on:submit="@post('/tasks/<%= t.id %>/claim')" class="inline">
          <input type="hidden" name="view" value="<%= it.view %>"><%~ include("/partials/list-query", it) %>
          <button class="link">Claim</button>
        </form>
      <% } %>
    </span>
  </div>
  <form class="rename" method="post" action="/tasks/<%= t.id %>/rename" style="display: none"
        data-show="<%= renaming %>" data-on:submit="@post('/tasks/<%= t.id %>/rename')">
    <input type="hidden" name="view" value="<%= it.view %>"><%~ include("/partials/list-query", it) %>
    <input id="rename-<%= t.id %>" name="title" value="<%= t.title %>" data-bind:rename-text required maxlength="300"
           autocomplete="off" autocapitalize="none" aria-label="Task name" data-on:keydown="evt.key === 'Escape' && ($renaming = '')">
    <div class="rename-actions">
      <button class="button primary">Save</button>
      <button type="button" class="button" data-on:click="$renaming = ''">Cancel</button>
      <a href="/tasks/<%= t.id %>/edit">All details →</a>
      <button class="link danger" formaction="/tasks/<%= t.id %>/delete" formnovalidate
              data-on:click__prevent="@post('/tasks/<%= t.id %>/delete')">Delete</button>
    </div>
  </form>
  <button type="button" class="icon rename-button" aria-label="Rename “<%= t.title %>”" title="Rename"
          data-title="<%= t.title %>" data-show="!(<%= renaming %>)"
          data-on:click="$renameText = el.dataset.title; $renaming = '<%= t.id %>'; setTimeout(() => { const i = document.getElementById('rename-<%= t.id %>'); i.focus(); i.select() })">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
  </button>
</li>
