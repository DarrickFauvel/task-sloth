<%/* The where/hows (placesPageView in src/web/places-page.js): the ones on the map first, each with its spots (an
     address links to the map; × removes it) and "Add a spot"; then the rest as chips, for putting one on the map.
     Both open that where/how's sheet (partials/place-sheets). Re-rendered after a spot is added or removed. */%>
<div id="places-list" class="settings">
  <% if (!it.rows.length) { %>
    <section class="panel" aria-labelledby="places-title">
      <h2 id="places-title"><span class="emoji" aria-hidden="true">🗺️</span> Your where / how</h2>
      <p class="hint">None yet. Add one by typing @ and a place in a task, like <code>milk @Target</code>, then come back here to put it on the map.</p>
    </section>
  <% } else { %>
    <section class="panel" aria-labelledby="on-map-title">
      <h2 id="on-map-title"><span class="emoji" aria-hidden="true">🗺️</span> On the map</h2>
      <% if (!it.onMap.length) { %>
        <p class="hint">Nothing yet. Tap one below that's a real place, like a shop, to put it on the map.</p>
      <% } %>
      <ul class="places">
        <% it.onMap.forEach((r) => { %>
          <li class="place" id="place-<%= r.id %>">
            <div class="place-head">
              <a class="place-name" href="/?<%= new URLSearchParams({ view: "all", context: r.id }) %>">@<%= r.name %></a>
              <span class="hint"><%= r.openCount %> open</span>
            </div>
            <ul class="spots">
              <% r.spots.forEach((sp) => { %>
                <li class="spot">
                  <a class="spot-where" href="<%= sp.mapHref %>" target="_blank" rel="noopener" title="See on the map"><span aria-hidden="true">📍</span> <%= sp.text %></a>
                  <form method="post" action="/spots/<%= sp.id %>/remove" data-on:submit="@post('/spots/<%= sp.id %>/remove', {contentType: 'form'})">
                    <button class="spot-remove" aria-label="Remove <%= sp.text %>" title="Remove this spot">×</button>
                  </form>
                </li>
              <% }) %>
            </ul>
            <button type="button" class="button add-spot" data-on:click="document.getElementById('sheet-<%= r.id %>').showModal()">+ Add a spot</button>
          </li>
        <% }) %>
      </ul>
      <% if (it.onMap.some((r) => r.spots.length > 1)) { %><p class="hint">A shop with several spots counts at any of them.</p><% } %>
    </section>

    <% if (it.offMap.length) { %>
      <section class="panel" aria-labelledby="off-map-title">
        <h2 id="off-map-title"><span class="emoji" aria-hidden="true">🧭</span> Not on the map</h2>
        <p class="hint">Tap one that's a real place, like a shop, to put it on the map. Leave the rest, like @phone, as they are.</p>
        <div class="pills">
          <% it.offMap.forEach((r) => { %>
            <button type="button" class="pill" data-on:click="document.getElementById('sheet-<%= r.id %>').showModal()">@<%= r.name %></button>
          <% }) %>
        </div>
      </section>
    <% } %>
  <% } %>
</div>
