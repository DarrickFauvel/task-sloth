<%/* The home page's top bar: the brand, then the household's name and your avatar as one button that
     opens the account menu. The menu is a native popover: tapping outside or Esc closes it, with no script. */%>
<% const u = it.user; const household = it.membership?.household.name; %>
<header class="bar app-header">
  <h1><a class="brand" href="/"><img class="brand-logo" src="/img/logo.png" alt="" width="192" height="192">Task Sloth</a></h1>
  <button type="button" class="account-button" popovertarget="account-menu"
          aria-label="Account menu for <%= u.name %><%= household ? `, ${household}` : "" %>">
    <% if (household) { %><span class="household-label"><%= household %></span><% } %>
    <%~ include("/partials/avatar", { user: u }) %>
  </button>
</header>
<div id="account-menu" popover class="menu" aria-label="Account">
  <div class="menu-head">
    <%~ include("/partials/avatar", { user: u, size: "lg" }) %>
    <div>
      <strong><%= u.name %></strong>
      <span class="hint"><%= household ?? "No household yet" %><%= u.username ? ` · @${u.username}` : "" %></span>
    </div>
  </div>
  <% if (household) { %><a class="menu-item" href="/activity"><span class="menu-icon" aria-hidden="true">🕘</span> Activity</a><% } %>
  <a class="menu-item" href="/settings"><span class="menu-icon" aria-hidden="true">⚙️</span> Settings</a>
  <a class="menu-item" href="/help"><span class="menu-icon" aria-hidden="true">❓</span> How it works</a>
  <a class="menu-item" href="/about"><span class="menu-icon" aria-hidden="true">ℹ️</span> About</a>
  <button type="button" class="menu-item" aria-haspopup="dialog"
          data-on:click="document.getElementById('account-menu').hidePopover(); document.getElementById('qr-dialog').showModal()">
    <span class="menu-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3M21 14v.01M14 21h3M21 18v3M17 21h.01"/></svg>
    </span>
    Show QR code
  </button>
  <%/* Says "Dark mode" (moon) while light and "Light mode" (sun) while dark; CSS picks. toggleTheme() is in the layout.
       The menu stays open, so the label visibly flips. */%>
  <button type="button" class="menu-item theme-toggle" data-on:click="toggleTheme(el)">
    <span class="menu-icon" aria-hidden="true">
      <svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </span>
    <span class="moon">Dark mode</span><span class="sun">Light mode</span>
  </button>
  <form method="post" action="/logout"><button class="menu-item"><span class="menu-icon" aria-hidden="true">↪</span> Sign out</button></form>
</div>
