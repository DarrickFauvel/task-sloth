<%/* The home page's top bar: brand, QR code, light/dark, and the avatar that opens the account menu.
     The menu is a native popover: tapping outside or Esc closes it, with no script. */%>
<% const u = it.user; %>
<header class="bar app-header">
  <div class="brand-block">
    <h1><a class="brand" href="/">Task Sloth</a></h1>
    <% if (it.membership) { %><p class="household-label"><%= it.membership.household.name %></p><% } %>
  </div>
  <div class="bar-actions">
    <button type="button" class="icon-button" aria-label="Show a QR code to open this app on another phone" aria-haspopup="dialog"
            data-on:click="document.getElementById('qr-dialog').showModal()">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
        <path d="M14 14h3v3M21 14v.01M14 21h3M21 18v3M17 21h.01"/>
      </svg>
    </button>
    <%/* Shows a moon in light mode and a sun in dark mode (CSS picks one); toggleTheme() is in the layout. */%>
    <button type="button" class="icon-button theme-toggle" aria-label="Switch between light and dark" title="Light / dark" data-on:click="toggleTheme(el)">
      <svg class="moon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button type="button" class="avatar-button" popovertarget="account-menu" aria-label="Account menu for <%= u.name %>">
      <%~ include("/partials/avatar", { user: u }) %>
    </button>
  </div>
</header>
<div id="account-menu" popover class="menu" aria-label="Account">
  <div class="menu-head">
    <%~ include("/partials/avatar", { user: u, size: "lg" }) %>
    <div>
      <strong><%= u.name %></strong>
      <span class="hint"><%= it.membership ? it.membership.household.name : "No household yet" %><%= u.username ? ` · @${u.username}` : "" %></span>
    </div>
  </div>
  <a class="menu-item" href="/settings"><span aria-hidden="true">⚙️</span> Settings</a>
  <a class="menu-item" href="/help"><span aria-hidden="true">❓</span> How it works</a>
  <form method="post" action="/logout"><button class="menu-item"><span aria-hidden="true">↪</span> Sign out</button></form>
</div>
