<% const t = it.task; const done = t.status === "done"; const action = done ? "reopen" : "done"; %>
<header id="task-head" class="task-head<%= done ? ' is-done' : '' %><%= t.priority > 0 ? ' is-high' : '' %>">
  <%/* Phone numbers in the title and notes are tap-to-call links. */%>
  <h1 class="task-title"><%~ include("/partials/phone-text", { parts: t.titleParts }) %></h1>
  <span class="meta">
    <% if (done) { %><span>Done</span><% } %>
    <% if (t.dueLabel) { %><span class="due <%= t.dueState %>"><%= t.dueText %></span><% } %>
    <% if (t.repeats) { %><span title="Repeats">↻ <%= t.repeats %></span><% } %>
    <% if (!done && t.list === "inbox") { %><span>📥 In <%= t.creator_id === it.userId ? "your" : "someone's" %> Inbox<% if (t.creator_id === it.userId) { %> · <a href="/sort?task=<%= t.id %>">Sort it</a><% } %></span><% } %>
    <% if (t.waitingLabel) { %><span>⏳ Waiting on <%= t.waitingLabel %></span><% } %>
    <% if (t.blockedBy && !done) { %><span class="blocked">⏳ Blocked until “<%= t.blockedBy %>” is done</span><% } %>
    <% if (!done && t.list === "someday") { %><span>💭 Maybe later</span><% } %>
    <% if (t.priority < 0) { %><span>Low priority</span><% } %>
    <% if (t.project_name) { %><a class="chip project" style="--c: <%= t.project_color %>" href="/?view=all&project=<%= t.project_id %>" title="All open tasks in <%= t.project_name %>"><%= t.project_emoji %> <%= t.project_name %></a><% } %>
    <%~ include("/partials/context-tags", { t }) %>
    <% if (t.assignee) { %>
      <span class="who"><span class="dot" style="background: <%= t.assignee.color %>"></span><%= t.assignee.id === it.userId ? "Me" : t.assignee.name %></span>
    <% } else if (!done) { %><span>Up for grabs</span><% } %>
  </span>
  <% if (t.blocking.length && !done) { %>
    <p class="holding-up">🔗 Holding up <%= t.blocking.map((b) => `“${b}”`).join(", ") %>. They'll be ready to go once this is done.</p>
  <% } %>
  <% if (t.notes) { %><p class="notes"><%~ include("/partials/phone-text", { parts: t.notesParts }) %></p><% } %>
  <div class="actions">
    <form method="post" action="/tasks/<%= t.id %>/<%= action %>" data-on:submit="@post('/tasks/<%= t.id %>/<%= action %>', {contentType: 'form'})">
      <input type="hidden" name="back" value="task">
      <button class="button<%= done ? '' : ' primary' %>"><%= done ? "Reopen" : "Mark done" %></button>
    </form>
    <a class="button" href="/tasks/<%= t.id %>/edit" data-show="!$editing" data-on:click__prevent="@get('/tasks/<%= t.id %>/edit')">Edit</a>
  </div>
</header>
